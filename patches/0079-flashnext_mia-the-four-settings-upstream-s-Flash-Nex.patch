 zig/src/families/flashnext_mia/cuda_env.zig | 9 ++++++++-
 zig/src/platform/environment.zig            | 4 ----
 zig/src/platform/environment_test.zig       | 4 ++++
 4 files changed, 15 insertions(+), 8 deletions(-)

