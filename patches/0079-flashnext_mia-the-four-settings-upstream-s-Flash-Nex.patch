--- a/zig/src/families/flashnext_mia/cuda_env.zig
+++ b/zig/src/families/flashnext_mia/cuda_env.zig
@@ -2,9 +2,16 @@
 const std = @import("std");
 const environment = @import("sys").environment;
 
-/// Refuses the first malformed setting of her rows, before the engine opens anything.
+/// Settings her engine reads that upstream's Flash Next registered first: their one `flashnext` row each applies.
+pub const shared = [_][:0]const u8{ "TF_FLASHNEXT_CONFIDENCE", "TF_FLASHNEXT_KEEP_LATE", "TF_FLASHNEXT_PROFILE", "TF_FLASHNEXT_SHARED_SIDE" };
+
+/// Refuses the first malformed setting of her rows and the shared ones, before the engine opens anything.
 pub fn startup() !void {
     try environment.checkScope(.flashnext_mia, environment.Process{});
+    inline for (shared) |name| {
+        comptime environment.registered(name);
+        try environment.check(name, (environment.Process{}).get(name));
+    }
 }
 
 /// A setting's text as set (null when unset) once its row accepts it; `startup` has refused a malformed one.
