--- /dev/null
+++ b/zig/src/native/cuda_lane_info.zig
@@ -0,0 +1,19 @@
+//! A CUDA family's in-model runner, compute lane and call gates on the Info it serves (TF_RUNNER*, TF_COMPUTE_LANE*).
+const std = @import("std");
+const api = @import("engine_api");
+const knob = &@import("cuda_device.zig").knob;
+
+/// `info` with what family F binds; the runner stays open for the engine's life (the server gives it the tokenizer).
+pub fn with(comptime F: type, gpa: std.mem.Allocator, info: api.Info) !api.Info {
+    var out = info;
+    const runner = if (@hasDecl(F, "runner")) if (try F.runner.parse(knob)) |rc| try api.runner.open(gpa, rc) else null else null;
+    if (runner != null) try F.runner.openRoundTrace(knob);
+    const compute = if (@hasDecl(F, "compute")) try F.compute.parse(knob) else null; // replies hold at EOS
+    // TF_COMPUTE_LANE_RUNNER=1 (S3, off by default): lane calls the circuit can run go there, sharing its circuit
+    out.compute_runner = if (@hasDecl(F, "compute")) try api.compute_circuit.open(F.compute, gpa, knob, compute != null, runner, null) else null;
+    out.compute = compute;
+    out.compute_tool = if (@hasDecl(F, "compute")) F.compute.tool else .{};
+    out.runner = runner;
+    out.call_gates = @hasDecl(F, "call_gates") and F.call_gates; // the lane core forces the call (lanes/call_gate.zig)
+    return out;
+}
