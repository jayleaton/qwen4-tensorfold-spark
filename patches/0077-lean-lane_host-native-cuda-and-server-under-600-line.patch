diff --git a/zig/src/server/server_lanes.zig b/zig/src/server/server_lanes.zig
new file mode 100644
index 000000000..155844041
--- /dev/null
+++ b/zig/src/server/server_lanes.zig
@@ -0,0 +1,24 @@
+//! The server's compute lane and in-model runner at start: sandboxes, S3 and the runner's text and guides.
+const std = @import("std");
+const Server = @import("server.zig").Server;
+const model_text = @import("model_text.zig");
+
+/// Opens what the engine's Info serves: the compute lane's sandboxes, S3 beside them and the runner's guides.
+pub fn open(srv: *Server, io: std.Io, text: model_text.Text) !void {
+    if (srv.info.compute) |c| srv.compute = try @import("compute_turns.zig").open(srv, c);
+    if (srv.compute != null) if (srv.info.compute_runner) |s| {
+        srv.compute_exec = .init(s);
+        std.log.info("compute lane: calls the circuit can run run there (in-model runner), the rest in the sandbox (code tool){s}", .{if (s.cfg.verify) "; verify: the sandbox's result is inserted" else ""});
+    };
+    if (srv.info.runner) |r| {
+        try @import("runner_text.zig").attach(srv.arena.allocator(), text, r);
+        srv.guides = try @import("runner_guide.zig").Set.load(srv.arena.allocator(), io, r.cfg.guide);
+        srv.guides.max_request_bytes = r.cfg.guide_max_bytes;
+        // the compute default (PREFIX_DEFAULT): the family's measured trust guide unless the boot names one
+        if (srv.compute != null and srv.info.compute.?.default and srv.guides.default.len == 0) srv.guides.default = r.cfg.family.trust orelse blk: {
+            std.log.warn("compute default: no trust guide is measured for this family; chats get none unless they ask", .{});
+            break :blk "";
+        };
+        srv.guides.describe();
+    }
+}
diff --git a/zig/src/server/server_queue_phase_test.zig b/zig/src/server/server_queue_phase_test.zig
new file mode 100644
index 000000000..fb6938f1f
--- /dev/null
+++ b/zig/src/server/server_queue_phase_test.zig
@@ -0,0 +1,22 @@
+//! The server's queue-phase metrics: noted only when explicitly enabled.
+const std = @import("std");
+const server = @import("server.zig");
+const clock = @import("clock.zig");
+const Config = server.Config;
+const Server = server.Server;
+
+test "queue phase: server notes measured waits only when explicitly enabled" {
+    const defaults: Config = .{ .served_name = "test", .model_ids = &.{"test"} };
+    try std.testing.expect(!defaults.phase_metrics);
+    for ([_]bool{ false, true }) |enabled| {
+        var srv: Server = undefined;
+        srv.io = std.testing.io;
+        srv.metrics = .{ .gpa = std.testing.allocator, .phases = enabled };
+        defer srv.metrics.deinit();
+        srv.noteRequest(10, 0, 3, 0, 0, 2, clock.nowNs(srv.io), null, null, 0.25, 0.3);
+        try std.testing.expectEqual(@as(u64, if (enabled) 1 else 0), srv.metrics.queue.n);
+        srv.noteRequest(10, 0, 3, 0, 0, 2, clock.nowNs(srv.io), null, null, null, null);
+        try std.testing.expectEqual(@as(u64, if (enabled) 1 else 0), srv.metrics.queue.n);
+        try std.testing.expectEqual(@as(u64, 6), srv.metrics.generation);
+    }
+}
