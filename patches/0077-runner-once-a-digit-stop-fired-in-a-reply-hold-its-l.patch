From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:58:08 +0700
Subject: [PATCH 77/79] runner: once a digit stop fired in a reply, hold its
 later reasoning digit runs at 64 digits

After the stop's newline Qwen3.8-Flash-Next TP2 restarted a fresh digit run on the next line, about 1,000 digits each until the run cap, 8 runs in one reply (digit gate, 3^300 and 2^500). TF_RUNNER_DIGIT_HOLD_MAX (default 64, 0 off) caps those later runs; forced rows and owned values are never cut.
---
 CHANGELOG.md                            |  2 +-
 zig/src/core/lanes/runner_stop.zig      | 26 ++++++++---
 zig/src/core/lanes/runner_stop_test.zig | 59 +++++++++++++++++++++++--
 zig/src/core/runner.zig                 |  6 ++-
 zig/src/core/runner_digit_stop_test.zig |  8 +++-
 5 files changed, 88 insertions(+), 13 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index a96f6ed74..28edf95fa 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -4,7 +4,7 @@ Each release's page on GitHub has its notes and measurements. See [the 1.0.0 rel
 
 ## Unreleased
 
-- In-model runner: in reasoning, the model's next token right after an owned inline integer may no longer start with a digit, and a reasoning digit run stops at 1,024 digits (`TF_RUNNER_DIGIT_STOP`, `TF_RUNNER_DIGIT_RUN_MAX`; on by default, 0 turns each off). The stopped token becomes a newline where it lands. On Qwen3.8-Flash-Next TP2 the model kept extending owned values such as 7^222 by 1,600-29,700 invented digits, so a reply ran into its thinking budget or `max_tokens` before it answered. Thinking-off replies, fence and REPL results are unchanged.
+- In-model runner: in reasoning, the model's next token right after an owned inline integer may no longer start with a digit, and a reasoning digit run stops at 1,024 digits (`TF_RUNNER_DIGIT_STOP`, `TF_RUNNER_DIGIT_RUN_MAX`; on by default, 0 turns each off). The stopped token becomes a newline where it lands. On Qwen3.8-Flash-Next TP2 the model kept extending owned values such as 7^222 by 1,600-29,700 invented digits, so a reply ran into its thinking budget or `max_tokens` before it answered. Thinking-off replies, fence and REPL results are unchanged. Once a stop fired in a reply, its later reasoning digit runs stop at 64 digits (`TF_RUNNER_DIGIT_HOLD_MAX`; 0 turns it off): after the newline the model restarted a fresh 1,000-digit run each line.
 
 - Server: Responses grows each output item in one buffer, and Kimi chat advances its native stream parser through new tokens, so a long reply retains memory in proportion to its length while every reply and streamed event stays the same (#2642).
 - Tests: `zig build bench-stream-scan` streams a 32k-token thinking reply (30,000 reasoning tokens, prose, then a Qwen XML, GLM, DSML or Kimi call) through the chat, Messages and Responses routes one or two tokens a chunk, and prints each chunk's request-thread time at 1k to 30k reply tokens, each whole-text step's time and the request arena; under `test-server-cpu` a 300-token reply checks that each route's streamed reasoning, prose and call arguments equal the reply's (#2642).
diff --git a/zig/src/core/lanes/runner_stop.zig b/zig/src/core/lanes/runner_stop.zig
index a9108e9cb..183c9d887 100644
--- a/zig/src/core/lanes/runner_stop.zig
+++ b/zig/src/core/lanes/runner_stop.zig
@@ -9,8 +9,8 @@ pub const Stop = struct { at: usize, token: u32, why: Why };
 
 pub const Why = enum { after_value, run_cap };
 
-/// PREFIX_DIGIT_STOP and PREFIX_DIGIT_RUN_MAX (core/runner.zig parses them); run_max 0: no cap.
-pub const Limits = struct { after_value: bool = true, run_max: u32 = 1024 };
+/// PREFIX_DIGIT_STOP, _RUN_MAX, _HOLD_MAX (runner.zig); 0: no cap. hold_max caps runs once a stop fired in the reply.
+pub const Limits = struct { after_value: bool = true, run_max: u32 = 1024, hold_max: u32 = 64 };
 
 /// One token's bytes, as the runner's tokenizer gives them.
 pub const Bytes = struct {
@@ -43,6 +43,7 @@ pub const State = struct {
     looked: bool = false, // `look` asked the tokenizer for it (once: one token or none)
     lead: ?usize = null, // armed: owned tokens still to land; at 0 the next token is the model's first after the value
     run: u32 = 0, // digits ending the reasoning's committed text
+    held: bool = false, // a stop fired in this reply: later runs cap at hold_max
 
     /// The newline token from `text` (its `encode`, as the runner's Text), asked once.
     pub fn look(st: *State, gpa: Allocator, text: anytype) Allocator.Error!void {
@@ -55,7 +56,20 @@ pub const State = struct {
 
     /// Whether the run nears its cap with the newline not yet asked for (the runner then calls `look`).
     pub fn wants(st: *const State) bool {
-        return !st.looked and st.limits.run_max > 0 and st.run +| 64 > st.limits.run_max;
+        const c = st.cap();
+        return !st.looked and c > 0 and st.run +| 64 > c;
+    }
+
+    /// The digit-run cap now (0: none): run_max, or hold_max once a stop fired.
+    pub fn cap(st: *const State) u32 {
+        const h = st.limits.hold_max;
+        if (!st.held or h == 0) return st.limits.run_max;
+        return if (st.limits.run_max == 0) h else @min(st.limits.run_max, h);
+    }
+
+    /// A stop this state returned was applied: the reply's later runs hold at hold_max.
+    pub fn fired(st: *State) void {
+        st.held = true;
     }
 
     /// An owned inline value is forced next: `count` tokens whose text is `value` (armed when it ends in a digit).
@@ -76,12 +90,13 @@ pub const State = struct {
         const nl = st.newline orelse return null;
         var lead = st.lead;
         var run = st.run;
+        const c = st.cap();
         for (tokens, 0..) |t, i| {
             const b = bytes.of(bytes.ctx, t);
             const owned = if (lead) |n| n > 0 else false;
             if (!owned and i >= forced and b.len > 0 and digit(b[0])) {
                 if (lead != null) return .{ .at = i, .token = nl, .why = .after_value };
-                if (st.limits.run_max > 0 and run +| leading(b) > st.limits.run_max) return .{ .at = i, .token = nl, .why = .run_cap };
+                if (c > 0 and run +| leading(b) > c) return .{ .at = i, .token = nl, .why = .run_cap };
             }
             if (lead) |n| lead = if (n > 0) n - 1 else null;
             run = extend(run, b);
@@ -92,7 +107,8 @@ pub const State = struct {
     /// Whether the next draw could be stopped: a pipelined stream reads it before feeding it.
     pub fn watching(st: *const State) bool {
         if (st.newline == null) return false;
-        return st.lead != null or (st.limits.run_max > 0 and st.run +| 16 > st.limits.run_max);
+        const c = st.cap();
+        return st.lead != null or (c > 0 and st.run +| 16 > c);
     }
 };
 
diff --git a/zig/src/core/lanes/runner_stop_test.zig b/zig/src/core/lanes/runner_stop_test.zig
