@@ -51,6 +51,7 @@ pub const State = struct {
     word: bool = false, // the armed span ends in a word character (the mark): its guard is `wordy`, not a digit
     run: u32 = 0, // digits ending the reasoning's committed text
     held: bool = false, // a stop fired in this reply: later runs cap at hold_max
+    fires: [3]u32 = @splat(0), // stops fired in this reply, by Why (the receipt's "stops"; the serving log's lines)
 
     /// The newline token from `text` (its `encode`, as the runner's Text), asked once.
     pub fn look(st: *State, gpa: Allocator, text: anytype) Allocator.Error!void {
@@ -76,6 +77,7 @@ pub const State = struct {
 
     /// A stop was applied: a digit stop holds later runs at hold_max; a mark stop does not, so numbers stay whole.
     pub fn fired(st: *State, why: Why) void {
+        st.fires[@backingInt(why)] +|= 1;
         if (why != .after_mark) st.held = true;
     }
 
diff --git a/zig/src/core/runner_digit_stop_test.zig b/zig/src/core/runner_digit_stop_test.zig
index 304aeaa8c..46c913399 100644
--- a/zig/src/core/runner_digit_stop_test.zig
+++ b/zig/src/core/runner_digit_stop_test.zig
@@ -169,3 +169,34 @@ test "runner digit stop: TF_R_DIGIT_STOP, _MARK_STOP, _RUN_MAX and _HOLD_MAX par
     K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" }, .{ "TF_R_DIGIT_RUN_MAX", "-1" } };
     try std.testing.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
 }
+
+/// `digits` drawn reasoning digits under a run cap of 8, then a "5": whether it stops, and the receipt (caller frees).
+fn capped(digits: usize) !struct { hit: bool, receipt: []u8 } {
+    var back: Back = .{};
+    defer back.deinit();
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{}, .frontend = .{ .translate = translate }, .backend = back.backend(), .text = .{ .bytes = bytes, .encode = encode } };
+    r.cfg.scan.inline_math = true;
+    r.cfg.digit_stop.run_max = 8;
+    const s = (try r.session(.{})).?;
+    defer s.destroy();
+    const hook = s.hook();
+    for (0..digits) |i| try std.testing.expect(!hook.token(hook.ptr, '1' + @as(u32, @intCast(i % 9)), true, true, false));
+    const hit = hook.stop.?(hook.ptr, &.{'5'}, 0);
+    if (hit) |h| try std.testing.expectEqual(@import("lanes").runner_stop.Why.run_cap, h.why);
+    return .{ .hit = hit != null, .receipt = try gpa.dupe(u8, s.receipt()) };
+}
+
+test "runner digit stop: a run cap that fired is in the reply's receipt though no cell was claimed; none fired, none listed" {
+    // the 11-14 opencode fib(250) reply: the cap cut a model-written 1,024-digit run, and the receipt said nothing
+    const cut = try capped(8);
+    defer gpa.free(cut.receipt);
+    try std.testing.expect(cut.hit);
+    try std.testing.expect(std.mem.indexOf(u8, cut.receipt, "\"inline\":{\"closed\":0,\"owned\":0,\"abstained\":0,\"owned_tokens\":0}") != null);
+    try std.testing.expect(std.mem.indexOf(u8, cut.receipt, ",\"stops\":{\"after_value\":0,\"after_mark\":0,\"run_cap\":1}") != null);
+    // negative control: one digit short of the cap nothing fires and the receipt is byte for byte as before
+    const short = try capped(7);
+    defer gpa.free(short.receipt);
+    try std.testing.expect(!short.hit);
+    try std.testing.expect(std.mem.indexOf(u8, short.receipt, "\"stops\"") == null);
+    try std.testing.expect(std.mem.endsWith(u8, short.receipt, "\"resume_ms\":0,\"cells\":[]}"));
+}
