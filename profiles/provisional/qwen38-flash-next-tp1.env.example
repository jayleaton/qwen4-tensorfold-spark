# PROVISIONAL Qwen3.8-Flash-Next TP1 control profile: the Phase 0 proving model (plans/PLAN.md), one Spark. This is
# not a Qwen4 size and none of its numbers carry over to one. It is the control every Phase 0 architecture arm is
# compared against: the plain upstream flashnext boot plus the two prefill chunk settings below.
# Copy to profiles/provisional/qwen38-flash-next-tp1.env (git-ignored) on the node and fill in the node-local values.
PROFILE=qwen38-flash-next-tp1
RANKS=1
IMAGE="<your-built-flashnext-image>"
MODEL_DIR="<absolute-qwen38-flash-next-tp1-model-directory>"
# This checkpoint's own folders: never reuse another pack's prepared files, calibration or sessions.
PREPARED_DIR="<absolute-qwen38-flash-next-tp1-prepared-directory>"
STATE_DIR="<absolute-qwen38-flash-next-tp1-state-directory>"
HOST=localhost
PORT=8000
# The pack the control was measured on: MLX 4-bit, group size 32, with the MTP head.
CHECKPOINT=TensorFold/Qwen3.8-Flash-Next-MLX-4bit-MTP@2b170fa6309d5d1ee380b35636075fac7945f286
QUANT_FORMAT=mlx-q4g32
CONTEXT=65536

# Prefill chunks (tokens): 1536 while other requests decode, 4096 when a prompt runs alone. Against the plain boot on
# the same pack: time to first token 13.35 s -> 12.12 s on a 24k-token prompt, prefill about 10% faster, 4-stream
# decode 83.2 -> 90.9 tokens/s, the same answers on the check subset, and about 1.3 GiB more peak memory.
TF_FLASHNEXT_CHUNK=1536
TF_FLASHNEXT_CHUNK_SOLO=4096

# Architecture switches: off in the control; the architecture arms turn them on.
COMPUTE_LANE=off
COMPUTE_LANE_DEFAULT=off
IN_THINKING_RUNNER=off
SESSIONS=off
