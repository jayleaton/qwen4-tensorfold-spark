# PROVISIONAL Qwen4-125B profile stub: Qwen has not announced or published this size, so this is a planning
# placeholder. Nothing here is measured or qualified; see plans/PLAN.md for the gates.
# Copy to profiles/provisional/qwen4-125b.env (git-ignored) on each node and fill in the node-local values.
# Checkpoint, architecture and quantization facts: TBD (research). Do not copy another model's numbers in here.
# Placement: one Spark at NVFP4 if the all-in count allows it (research arithmetic, not a measurement);
# two Sparks over RoCE only if it does not (an all-in count near 180B with tables and MTP may not fit one Spark).
PROFILE=qwen4-125b
RANKS=1
IMAGE="<your-built-runner-image>"
MODEL_DIR="<absolute-qwen4-125b-model-directory>"
# This checkpoint's own folders: never reuse another pack's prepared files, calibration or sessions.
PREPARED_DIR="<absolute-qwen4-125b-prepared-directory>"
STATE_DIR="<absolute-qwen4-125b-state-directory>"
HOST=localhost
PORT=8000
CHECKPOINT=TBD
QUANT_FORMAT=TBD
CONTEXT=TBD
# Two-node link settings, only if this size moves to TP2 (set RANKS=2 and uncomment).
# TF_TP_MASTER="<rank-0-link-address>"
# TF_TP_PORT="<tp-port>"
# TF_COMM_BACKEND=roce
# NCCL_SOCKET_IFNAME="<link-interface>"
# NCCL_IB_HCA="<cabled-RDMA-devices>"

# Architecture switches (plans/PLAN.md). The engine's variable names are set when the shared compute lane lands
# (plan step C); until then these are recipe-level intents, read by no engine.
COMPUTE_LANE=planned
COMPUTE_LANE_DEFAULT=planned
IN_THINKING_RUNNER=planned
SESSIONS=planned
